# Copy to .env and fill in. .env is git-ignored: never commit it.

# Password for the PostgreSQL database (any long random string).
POSTGRES_PASSWORD=

# Admin login for the admin screen.
LUNCH_ADMIN_USERNAME=admin
# BCrypt hash of the admin password (see README).
# Keep the single quotes: $ in the hash must not be expanded.
LUNCH_ADMIN_PASSWORD_HASH=''

# Security token Teams shows once when you create the outgoing webhook.
LUNCH_TEAMS_SECURITY_TOKEN=

# Anthropic API key for reading free-text messages. Empty: free text gets the fallback reply.
ANTHROPIC_API_KEY=

# Time zone for the cut-off and "today".
LUNCH_TIME_ZONE=Europe/Brussels

# ngrok: authtoken and your fixed domain (host name only, e.g. calm-otter-123.ngrok-free.app).
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
